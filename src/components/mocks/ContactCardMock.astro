---
import Avatar from "../Avatar.astro";

const fields = [
  ["Кто", "Продакт в финтехе"],
  ["Откуда", "Конференция в Казани"],
  ["Телефон", "+7 900 123-45-67"],
  ["Почта", "anna@sokolova.ru"],
];
---

<div class="flex flex-col gap-12 rounded-16 bg-white p-16 shadow-mock md:gap-14 md:p-18">
  <div class="flex items-center gap-12">
    <Avatar initials="АС" class="size-40 bg-pistachio text-13 md:size-42" />
    <div class="text-16 font-bold md:text-17">Анна Соколова</div>
  </div>
  <dl
    class="grid grid-cols-[76px_minmax(0,1fr)] gap-x-10 gap-y-8 text-14 leading-table font-medium md:grid-cols-[80px_minmax(0,1fr)] md:gap-y-10 md:text-15"
  >
    {
      fields.map(([label, value]) => (
        <>
          <dt class="text-12 font-semibold text-muted md:text-13">{label}</dt>
          <dd>{value}</dd>
        </>
      ))
    }
  </dl>
</div>
