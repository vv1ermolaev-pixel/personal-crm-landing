---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  // Rendered widths at 1x and 2x, large enough for the `object-cover` crop
  widths: [number, number];
  priority?: boolean;
  class?: string;
}

const { src, alt, widths, priority = false, class: className } = Astro.props;
const sizes = `${widths[0]}px`;

const [avif, webp, fallback] = await Promise.all([
  getImage({ src, widths, format: "avif" }),
  getImage({ src, widths, format: "webp" }),
  getImage({ src, width: widths[0], format: "jpg" }),
]);

// Photos are desktop-only: phones get a 1px stub instead of downloading them
const BLANK = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
---

<picture class:list={["hidden md:block", className]}>
  <source media="(max-width: 767.98px)" srcset={BLANK} />
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
  <img
    src={fallback.src}
    alt={alt}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class="block size-full rounded-32 object-cover"
  />
</picture>
